// Волна
class WaveClipper extends CustomClipper<Path> {
  final double progress;
  WaveClipper(this.progress);

  @override
  Path getClip(Size size) {
    final path = Path();
    path.lineTo(0, size.height * 0.75);
    path.quadraticBezierTo(
      size.width * 0.5,
      size.height * (0.75 + 0.25 * progress),
      size.width,
      size.height * 0.55,
    );
    path.lineTo(size.width, 0);
    path.close();
    return path;
  }

  @override
  bool shouldReclip(covariant WaveClipper oldClipper) => oldClipper.progress != progress;
}

